# Coding Guru — Runtime Environment Variables
# Copy this file to .env and fill in your values before running the container:
#   docker run --env-file .env -d -p 5000:5000 hridayesh68/coding-guru:latest

PORT=5000
JWT_SECRET=your_jwt_secret_here
ADMIN_INVITE_KEY=your_admin_key_here

# Gemini API Keys (Automatic Multi-Key Failover Pool)
GEMINI_API_KEY=your_gemini_key_1
GEMINI_API_KEY_2=your_gemini_key_2
GEMINI_API_KEY_3=your_gemini_key_3
GEMINI_API_KEY_4=your_gemini_key_4
GEMINI_API_KEY_5=your_gemini_key_5
GEMINI_API_KEY_6=your_gemini_key_6
GEMINI_API_KEY_7=your_gemini_key_7
GEMINI_API_KEY_8=your_gemini_key_8
GEMINI_API_KEY_9=your_gemini_key_9
GEMINI_API_KEY_10=your_gemini_key_10

# Groq API Keys (Secondary Provider Backup)
GROQ_API_KEY=your_groq_key_1
GROQ_API_KEY_2=your_groq_key_2
