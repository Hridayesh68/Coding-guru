    {
      "id": "q_palindrome_number",
      "title": "Palindrome Number",
      "slug": "palindrome-number",
      "difficulty": "Easy",
      "tags": [
        "Math"
      ],
      "description": "Given an integer `x`, return `true` if `x` is a palindrome, and `false` otherwise.\n\nAn integer is a **palindrome** when it reads the same forward and backward.\nFor example, `121` is a palindrome while `123` is not.\n\n### Example 1:\n```text\nInput: x = 121\nOutput: true\n```\n\n### Example 2:\n```text\nInput: x = -121\nOutput: false\nExplanation: From left to right, it reads -121. From right to left, it becomes 121-. Therefore it is not a palindrome.\n```\n\n### Constraints:\n- `-2^31 <= x <= 2^31 - 1`",
      "starterCode": {
        "javascript": "function isPalindrome(x) {\n  // Write your code here\n  if (x < 0) return false;\n  const s = x.toString();\n  return s === s.split('').reverse().join('');\n}",
        "python": "def is_palindrome(x):\n    # Write your code here\n    if x < 0:\n        return False\n    s = str(x)\n    return s == s[::-1]"
      },
      "testCases": [
        {
          "id": 1,
          "input": "{\"x\": 121}",
          "expectedOutput": "true",
          "isHidden": false,
          "explanation": "Standard palindrome"
        },
        {
          "id": 2,
          "input": "{\"x\": -121}",
          "expectedOutput": "false",
          "isHidden": false,
          "explanation": "Negative numbers are not palindromes"
        },
        {
          "id": 3,
          "input": "{\"x\": 10}",
          "expectedOutput": "false",
          "isHidden": false,
          "explanation": "Ending in zero"
        },
        {
          "id": 4,
          "input": "{\"x\": 0}",
          "expectedOutput": "true",
          "isHidden": false,
          "explanation": "Single digit zero"
        },
        {
          "id": 5,
          "input": "{\"x\": 7}",
          "expectedOutput": "true",
          "isHidden": true,
          "explanation": "Single positive digit"
        },
        {
          "id": 6,
          "input": "{\"x\": 1221}",
          "expectedOutput": "true",
          "isHidden": true,
          "explanation": "Even length palindrome"
        },
        {
          "id": 7,
          "input": "{\"x\": 123454321}",
          "expectedOutput": "true",
          "isHidden": true,
          "explanation": "Large odd length palindrome"
        },
        {
          "id": 8,
          "input": "{\"x\": 1000021}",
          "expectedOutput": "false",
          "isHidden": true,
          "explanation": "Non-palindrome with zeros"
        },
        {
          "id": 9,
          "input": "{\"x\": 123321}",
          "expectedOutput": "true",
          "isHidden": true,
          "explanation": "6-digit palindrome"
        },
        {
          "id": 10,
          "input": "{\"x\": 999999}",
          "expectedOutput": "true",
          "isHidden": true,
          "explanation": "All matching digits"
        }
      ],
